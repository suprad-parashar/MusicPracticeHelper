            "||"
          ],
          "lyrics": "Saama Nigamaja Sudhaamaya Gaana Vichakshana Gunasheela Dayaalavaala Maam Paalaya",
          "translation": "O expounder of the nectar-like music arising from the Saama Veda! Thou of great qualities and mercy! Care for me."
        }
      ]
    },
    {
      "section": "charanam",
      "raga_id": "hindolam",
