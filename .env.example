# OpenAI API Key (required for LLM extraction)
OPENAI_API_KEY=your-api-key-here

# Model to use (default: gpt-5.4)
# Options: gpt-5.4, gpt-5.4-mini, gpt-5.4-nano, gpt-4o, gpt-4o-mini
OPENAI_MODEL=gpt-5.4

# Max context chars sent to LLM (lower = fewer tokens, avoids TPM limits)
# 25000 chars ≈ 6250 tokens — safe for 10k TPM tier
# Increase if you have higher rate limits
MAX_CONTEXT_CHARS=25000

# Minimum delay between LLM API calls in seconds (helps avoid rate limits)
LLM_CALL_DELAY=2.0

# Wikipedia crawl delay between requests in seconds
WIKI_CRAWL_DELAY=0.5
